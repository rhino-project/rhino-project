{
  "name": "@rhino-project/eslint-plugin-rhino",
  "version": "0.30.0-alpha.40",
  "description": "ESLint plugin for Rhino",
  "author": "JP Rosevear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhino-project/rhino-project.git",
    "directory": "packages/eslint-plugin-rhino"
  },
  "homepage": "https://github.com/rhino-project/rhino-project",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf ./build && rimraf ./coverage",
    "test:eslint": "eslint src",
    "test:types": "tsc",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm run test:lib --watch",
    "test:build": "publint --strict",
    "build": "vite build"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@typescript-eslint/rule-tester": "8.24.1",
    "@typescript-eslint/utils": "8.24.1"
  },
  "devDependencies": {
    "eslint": "9.20.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  }
}
