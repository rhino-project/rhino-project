    "@stripe/react-stripe-js": "2.1.0",
    "@stripe/stripe-js": "1.52.0",
    "@types/qs": "^6.9.18",
    "axios": "1.8.2",
    "lodash-es": "4.17.21",
    "qs": "6.14.0",
    "react-hook-form": "7.49.2",
    "react-use": "17.5.1",
    "use-debounce": "10.0.4",
    "uuid": "11.1.0",
    "yup": "1.3.3"
