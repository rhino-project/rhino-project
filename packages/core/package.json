  "devDependencies": {
    "@babel/parser": "^7.17.0",
    "@babel/traverse": "^7.17.0",
    "@tanstack/react-query-devtools": "5.66.11",
    "@tanstack/react-table": "8.20.1",
    "@testing-library/dom": "10.0.0",
    "@testing-library/react": "16.1.0",
    "@types/lodash-es": "^4.17.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
