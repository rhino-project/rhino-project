  },
  "homepage": "https://rhino-project.org",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/esm/config.d.ts",
        "default": "./dist/esm/config.js"
      }
    },
    "./config/assets": {
      "import": {
        "types": "./dist/esm/config/assets.d.ts",
        "default": "./dist/esm/config/assets.js"
      }
    },
    "./config/env": {
      "import": {
        "types": "./dist/esm/config/env.d.ts",
        "default": "./dist/esm/config/env.js"
      }
    },
    "./queries": {
      "import": {
        "types": "./dist/esm/queries/index.d.ts",
        "default": "./dist/esm/queries/index.js"
      }
