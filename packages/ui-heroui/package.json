  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./style": {
      "import": {
        "default": "./dist/style.css"
      },
      "require": {
        "default": "./dist/style.css"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:types": "tsc",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm run test:lib --watch",
    "test:build": "publint --strict",
    "test:eslint": "eslint --max-warnings 0 ./src ",
    "build": "vite build",
    "extract:components": "node ./extractComponents.js",
    "copy:fields": "node ./copyAndReplace.js",
    "copy:displays": "node ./copyAndReplaceDisplay.js"
  },
  "keywords": [],
  "engines": {
    "node": ">=18"
  },
