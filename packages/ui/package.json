{
  "name": "@rhino-project/ui",
  "version": "0.30.0-alpha.14",
  "description": "",
  "author": "JP Rosevear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhino-project/rhino-project.git",
    "directory": "packages/ui"
  },
  "homepage": "https://rhino-project.org",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./style": {
      "import": {
        "default": "./dist/style.css"
      },
      "require": {
        "default": "./dist/style.css"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:types": "tsc",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm run test:lib --watch",
    "test:build": "publint --strict",
    "test:eslint": "eslint --max-warnings 0 ./src ",
    "build": "vite build",
    "extract:components": "node ./extractComponents.js",
    "copy:fields": "node ./copyAndReplace.js",
    "copy:displays": "node ./copyAndReplaceDisplay.js"
  },
  "keywords": [],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@hookform/devtools": "4.3.1",
    "@hookform/resolvers": "3.3.2",
    "@rails/actioncable": "7.1.3-4",
    "@rails/activestorage": "7.1.3-4",
    "@rhino-project/core": "workspace:*",
    "@stripe/react-stripe-js": "2.1.0",
    "@stripe/stripe-js": "1.52.0",
    "@tanstack/react-table": "8.20.1",
    "axios": "1.7.4",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "classnames": "2.3.1",
    "date-fns": "2.29.0",
    "lodash-es": "4.17.21",
    "prop-types": "15.7.2",
    "qs": "6.9.7",
    "react-bootstrap-typeahead": "6.3.2",
    "react-datepicker": "4.8.0",
    "react-hook-form": "7.49.2",
    "react-phone-input-2": "2.15.1",
    "react-use": "17.5.1",
    "reactstrap": "^9.1.9",
    "use-debounce": "10.0.4",
    "uuid": "8.3.2",
    "yup": "1.3.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.17.0",
    "@babel/traverse": "^7.17.0",
    "@tanstack/react-query-devtools": "4.32.6",
    "@testing-library/react": "16.1.0",
    "@testing-library/dom": "10.0.0",
    "@types/lodash-es": "^4.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "24.1.1"
  },
  "peerDependencies": {
    "@rollbar/react": "0.11.2",
    "@tanstack/react-query": "^4.32.6",
    "@tanstack/react-query-devtools": "4.32.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.16.0",
    "rollbar": "2.26.2"
  }
}
